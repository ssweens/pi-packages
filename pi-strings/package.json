{
  "name": "@ssweens/pi-strings",
  "version": "0.1.0",
  "type": "module",
  "description": "Robust multi-agent orchestration for Pi over ACP, with a hardened vendored Pi adapter",
  "keywords": [
    "pi-package",
    "pi-coding-agent",
    "multi-agent",
    "subagents",
    "acp",
    "acpx"
  ],
  "author": "ssweens",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "dist/",
    "docs/",
    "extensions/",
    "skills/",
    "vendor/pi-acp/LICENSE",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE.md",
    "README.md",
    "TEST_COVERAGE.md"
  ],
  "dependencies": {
    "@agentclientprotocol/sdk": "1.3.0",
    "acpx": "0.13.0",
    "proper-lockfile": "4.1.2",
    "typebox": "1.3.7",
    "write-file-atomic": "7.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.83.0",
    "@types/node": "^24.12.4",
    "@types/proper-lockfile": "^4.1.4",
    "@types/write-file-atomic": "^4.0.3",
    "esbuild": "^0.25.12",
    "tsx": "4.23.1",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.83.0 <0.84.0",
    "typebox": ">=1.3.7"
  },
  "pi": {
    "extensions": [
      "./extensions/pi-strings/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "npm run typecheck && npm test",
    "prepack": "npm run check",
    "test": "npm run build && node --import tsx --test tests/*.test.ts tests/integration/*.test.ts",
    "test:integration": "node --import tsx --test tests/integration/*.test.ts",
    "test:e2e": "PI_STRINGS_E2E=1 node --import tsx --test tests/integration/*.test.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.vendor.json --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ssweens/pi-packages.git",
    "directory": "pi-strings"
  },
  "homepage": "https://github.com/ssweens/pi-packages/tree/main/pi-strings#readme",
  "bugs": {
    "url": "https://github.com/ssweens/pi-packages/issues"
  }
}
