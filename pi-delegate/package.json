{
  "name": "@ssweens/pi-delegate",
  "version": "0.1.0",
  "description": "Minimal delegation for pi: two tools, role files, fork context, steer, honest run log.",
  "type": "module",
  "main": "src/index.ts",
  "license": "MIT",
  "scripts": {
    "check": "npm run typecheck && npm test",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "check:install": "tsx test/install-smoke.ts",
    "smoke:tui": "tsx test/terminal-smoke.ts"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "dependencies": {
    "proper-lockfile": "^4.1.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.86.1",
    "@earendil-works/pi-ai": ">=0.86.1",
    "@earendil-works/pi-tui": ">=0.86.1",
    "typebox": "^1.3.27"
  },
  "keywords": [
    "pi-package"
  ],
  "devDependencies": {
    "@types/proper-lockfile": "4.1.4",
    "@types/node": "22.19.19",
    "@earendil-works/pi-coding-agent": "0.86.1",
    "@earendil-works/pi-ai": "0.86.1",
    "@earendil-works/pi-tui": "0.86.1",
    "typebox": "1.3.27",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
